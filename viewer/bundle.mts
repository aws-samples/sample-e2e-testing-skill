// src/build.ts を依存ごと 1 つの ESM ファイルにまとめ、スキルが配る skills/e2e-testing/viewer/build.mjs に書き出す。viewer で `pnpm run bundle` として実行する。
// あわせて、取り込んだ第三者のパッケージのライセンス全文をリポジトリ直下の THIRD-PARTY-LICENSES に書き出す。
// 引数を 2 つ渡すと、build.mjs と THIRD-PARTY-LICENSES をそのパスに書き出す(test/bundle.test.ts が一時ディレクトリへの出力に使う)。
// 同じソースとロックファイルからは、書き出す先によらず同じバイト列になる。出力には日時も絶対パスも入れない
import fs from 'node:fs';
import path from 'node:path';
import process from 'node:process';
import { build } from 'esbuild';

const VIEWER_DIR = import.meta.dirname;
const DEFAULT_OUTFILE = path.join(VIEWER_DIR, '..', 'skills', 'e2e-testing', 'viewer', 'build.mjs');
const DEFAULT_NOTICES_FILE = path.join(VIEWER_DIR, '..', 'THIRD-PARTY-LICENSES');
/** THIRD-PARTY-LICENSES の先頭。LICENSE と並べて置く帰属文書なので、LICENSE と同じく英語で書く */
const NOTICES_HEADER = [
  'Third-party software included in skills/e2e-testing/viewer/build.mjs.',
  'Generated by viewer/bundle.mts from the packages bundled into that file; do not edit by hand.',
];
/** build.mjs の先頭のコメント。生成物であること、元のソースの場所、作り直すコマンド */
const HEADER = [
  '// E2E テスト仕様のビューアのビルド。生成物なので、手で編集しない。',
  '// 元のソースはリポジトリの viewer/(入口は viewer/src/build.ts)。作り直すには viewer/ で `pnpm run bundle` を実行する。',
];
/**
 * CommonJS の react-dom は Node の組み込みモジュールを require する。ESM にまとめると require が無く、
 * 実行時に「Dynamic require of "util" is not supported」で落ちるので、createRequire で用意する。
 * まとめたコードの中の import と名前がぶつからないよう、別名で import する
 */
const REQUIRE_SHIM = [
  "import { createRequire as __bannerCreateRequire } from 'node:module';",
  'const require = __bannerCreateRequire(import.meta.url);',
];
/** metafile の入力のパスから、パッケージのディレクトリ(最後の node_modules/<名前> まで)を取り出す */
const PACKAGE_DIR_RE = /^((?:.*\/)?node_modules\/(?:@[^/]+\/)?[^/]+)\//;

type PackageJson = { name: string; version: string; license: string };

/** 出力に 1 バイトでも入ったパッケージのディレクトリ(VIEWER_DIR からの相対)を名前順に返す */
function bundledPackageDirs(inputs: Record<string, { bytesInOutput: number }>): string[] {
  const dirs = new Set<string>();
  for (const [input, { bytesInOutput }] of Object.entries(inputs)) {
    const dir = PACKAGE_DIR_RE.exec(input)?.[1];
    if (dir !== undefined && bytesInOutput > 0) dirs.add(dir);
  }
  return [...dirs].sort();
}

/**
 * パッケージの名前・版・ライセンスの種類と、LICENSE ファイルの本文。legalComments では MIT や ISC のパッケージの表記が残らないので、これで足す。
 * data: URL で取り込んだ書体のパッケージ(OFL-1.1)も、ここで LICENSE の全文が入る
 */
function licenseNotice(dir: string): string {
  const absDir = path.join(VIEWER_DIR, dir);
  const pkg: PackageJson = JSON.parse(fs.readFileSync(path.join(absDir, 'package.json'), 'utf8'));
  const licenseFile = fs
    .readdirSync(absDir)
    .filter((name) => /^licen[cs]e(\.|$)/i.test(name))
    .sort()[0];
  if (licenseFile === undefined) throw new Error(`${pkg.name} に LICENSE ファイルが無い: ${absDir}`);
  const text = fs.readFileSync(path.join(absDir, licenseFile), 'utf8').replaceAll('\r\n', '\n').trimEnd();
  return `${pkg.name}@${pkg.version}(${pkg.license})\n\n${text}`;
}

/** 行コメントにする。空行は `//` だけにする */
function toLineComments(text: string): string {
  return text
    .split('\n')
    .map((line) => (line === '' ? '//' : `// ${line}`))
    .join('\n');
}

/**
 * index.html の <style> と <script> に埋め込む中身に <tr が無いことを確かめる。document.tsx の renderHtml は <tr の直前で改行するが、
 * <style> と <script> の中身は React がエスケープしないので、そこに <tr があると改行が CSS かスクリプトの中に入る
 */
export function assertNoTableRowTag(name: string, text: string): void {
  if (/<tr/.test(text)) throw new Error(`${name} に <tr がある。index.html の行ごとの改行が <style> か <script> の中に入る`);
}

// 直接実行されたときだけまとめる。test/bundle.test.ts が assertNoTableRowTag を import したときは何も書き出さない
if (import.meta.main) {
  const outfile = path.resolve(process.argv[2] ?? DEFAULT_OUTFILE);
  const noticesFile = path.resolve(process.argv[3] ?? DEFAULT_NOTICES_FILE);
  for (const file of ['src/styles.css', 'src/font.ts']) assertNoTableRowTag(file, fs.readFileSync(path.join(VIEWER_DIR, file), 'utf8'));
  // HTML の <script> に直接書く、列の幅を変えるコード。file:// で開いても動くよう、モジュールでなく即時実行の形にまとめる
  const columnResize = await build({
    absWorkingDir: VIEWER_DIR,
    stdin: {
      contents: "import { enableColumnResize } from './src/column-resize';\nenableColumnResize(document);\n",
      resolveDir: VIEWER_DIR,
      sourcefile: 'column-resize-entry.ts',
      loader: 'ts',
    },
    bundle: true,
    platform: 'browser',
    format: 'iife',
    write: false,
    logLevel: 'warning',
  });
  assertNoTableRowTag('列の幅を変えるスクリプト', columnResize.outputFiles[0].text);
  const result = await build({
    // esbuild がモジュールの区切りに書くコメントのパスを、このディレクトリからの相対にする。出力に絶対パスを入れないため
    absWorkingDir: VIEWER_DIR,
    entryPoints: ['src/build.ts'],
    outfile,
    bundle: true,
    platform: 'node',
    format: 'esm',
    target: 'node22.18',
    jsx: 'automatic',
    // React の本番用のビルドを取り込む。document.tsx の COLUMN_RESIZE_SCRIPT は、上でまとめた列の幅を変えるコードの文字列にする。
    // import.meta.main を false にし、取り込んだ照合ツールの CLI を build.mjs の中で動かさない(build.mjs を直接実行すると true になるため)
    define: {
      'process.env.NODE_ENV': '"production"',
      COLUMN_RESIZE_SCRIPT: JSON.stringify(columnResize.outputFiles[0].text),
      'import.meta.main': 'false',
    },
    // 差分を読めるよう、minify しない
    legalComments: 'eof',
    // 書体の woff2 は data: URL の文字列として取り込む。file:// で開く HTML から外のファイルを参照しないため
    loader: { '.css': 'text', '.woff2': 'dataurl' },
    banner: { js: [...HEADER, ...REQUIRE_SHIM].join('\n') },
    write: false,
    metafile: true,
    logLevel: 'warning',
  });
  const [output] = result.outputFiles;
  const [meta] = Object.values(result.metafile.outputs);
  const notices = bundledPackageDirs(meta.inputs).map(licenseNotice);
  const licenses = toLineComments(['このファイルに取り込んだパッケージのライセンス', ...notices].join('\n\n'));
  fs.mkdirSync(path.dirname(outfile), { recursive: true });
  fs.writeFileSync(outfile, `${output.text}\n${licenses}\n`);
  fs.mkdirSync(path.dirname(noticesFile), { recursive: true });
  fs.writeFileSync(noticesFile, `${[...NOTICES_HEADER, ...notices].join('\n\n')}\n`);
}
