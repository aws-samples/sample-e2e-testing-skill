{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowArbitraryExtensions": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["bundle.mts", "vitest.config.ts", "src", "test", ".storybook/*.ts", "stories"],
  "exclude": ["test/fixtures"]
}
